---
import { site } from "../config";

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.descripcion } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const origin = site.url + base;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = `${origin}/portadas/01.jpg`;

// Datos estructurados para Google: negocio local de fotografía
const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${origin}/#negocio`,
  name: site.name,
  image: ogImage,
  description: site.descripcion,
  url: origin,
  telephone: site.telefono,
  email: site.email,
  priceRange: "€€",
  address: {
    "@type": "PostalAddress",
    addressLocality: site.ciudad,
    addressRegion: site.provincia,
    addressCountry: site.pais,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: site.lat,
    longitude: site.lon,
  },
  areaServed: site.zonas.map((z) => ({ "@type": "Place", name: z })),
  sameAs: [site.instagram, site.galerias],
  founder: { "@type": "Person", name: "John Arias" },
  knowsLanguage: ["es", "ca"],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios de fotografía y vídeo",
    itemListElement: site.servicios.map((s) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: s },
    })),
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    {
      site.enRevision && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    <meta name="theme-color" content="#0c0c0c" />
    <meta name="author" content="John Arias" />
    <meta name="geo.region" content="ES-CT" />
    <meta name="geo.placename" content={`${site.ciudad}, ${site.provincia}`} />
    <script is:inline>document.documentElement.classList.add("js");</script>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href={`${base}/`} class="wordmark" aria-label="John Arias — Fotografía y Video">
          <img src={`${base}/logo.png`} alt="John Arias" width="800" height="450" />
        </a>
        <nav class="site-nav">
          <a href="#trabajo">Fotografía</a>
          <a href="#video">Video</a>
          <a href="#servicios">Servicios</a>
          <a href="#contacto">Contacto</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} John Arias</span>
        <span>Todas las imágenes son propiedad del autor</span>
      </div>
    </footer>

    <script>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("visible");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
        );
        document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

        // Escalonado dentro de la retícula: cada columna entra con un pequeño retraso
        document.querySelectorAll(".work-grid").forEach((grid) => {
          [...grid.children].forEach((el, i) => {
            el.style.setProperty("--reveal-delay", `${(i % 3) * 100}ms`);
          });
        });

        // Video que se reproduce solo al entrar en pantalla (y se pausa al salir)
        const scrollVideos = document.querySelectorAll("video[data-scroll-play]");
        if (scrollVideos.length) {
          const vio = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                const v = e.target;
                if (e.isIntersecting) {
                  v.muted = true;
                  v.play().catch(() => {});
                } else {
                  v.pause();
                }
              }
            },
            { threshold: 0.4 },
          );
          scrollVideos.forEach((v) => vio.observe(v));
        }

        // Parallax sutil del hero: se desplaza y desvanece al hacer scroll
        const hero = document.querySelector(".hero-inner");
        if (hero) {
          let ticking = false;
          window.addEventListener(
            "scroll",
            () => {
              if (ticking) return;
              ticking = true;
              requestAnimationFrame(() => {
                const p = Math.min(window.scrollY / window.innerHeight, 1);
                hero.style.transform = `translateY(${window.scrollY * 0.25}px)`;
                hero.style.opacity = String(1 - p * 0.9);
                ticking = false;
              });
            },
            { passive: true },
          );
        }
      }

      // Obturador: clic en una foto = tomar una foto (animación + sonido)
      let actx;
      function shutterSound() {
        try {
          actx = actx || new (window.AudioContext || window.webkitAudioContext)();
          const click = (t, dur, freq, vol) => {
            const buf = actx.createBuffer(1, Math.floor(actx.sampleRate * dur), actx.sampleRate);
            const d = buf.getChannelData(0);
            for (let i = 0; i < d.length; i++) {
              d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / d.length, 2);
            }
            const src = actx.createBufferSource();
            src.buffer = buf;
            const f = actx.createBiquadFilter();
            f.type = "bandpass";
            f.frequency.value = freq;
            f.Q.value = 1.1;
            const g = actx.createGain();
            g.gain.value = vol;
            src.connect(f);
            f.connect(g);
            g.connect(actx.destination);
            src.start(t);
          };
          const t0 = actx.currentTime;
          click(t0, 0.03, 2600, 0.5); // espejo sube
          click(t0 + 0.1, 0.06, 1300, 0.8); // obturador
        } catch (e) {
          /* sin audio, la animación sigue */
        }
      }

      document.querySelectorAll(".work-item").forEach((item) => {
        item.addEventListener("click", (ev) => {
          ev.preventDefault();
          // El obturador hace de transicion: al terminar se abre el carrusel
          const dlg = document.getElementById("lb-" + item.dataset.galeria);
          if (dlg) {
            const track = dlg.querySelector(".lb-track");
            montarSlides(track);
            setTimeout(() => {
              dlg.showModal();
              track.scrollLeft = 0;
              dlg.querySelector(".lb-contador").textContent = "1 / " + track.dataset.n;
            }, 260);
          }
          const fig = item.querySelector("figure");
          let sh = fig.querySelector(".shutter");
          if (!sh) {
            sh = document.createElement("div");
            sh.className = "shutter";
            sh.innerHTML =
              '<div class="blade top"></div><div class="blade bottom"></div><div class="flash"></div>';
            fig.appendChild(sh);
          }
          sh.classList.remove("firing");
          void sh.offsetWidth; // reinicia la animación
          sh.classList.add("firing");
          shutterSound();
          setTimeout(() => sh.classList.remove("firing"), 650);
        });
      });

      // Las fotos del carrusel se crean al abrirlo. Si van en el HTML, el
      // navegador las descarga todas al cargar la pagina aunque el <dialog>
      // este cerrado y lleven loading="lazy".
      function montarSlides(track) {
        if (track.children.length) return;
        const { src, n, titulo } = track.dataset;
        const frag = document.createDocumentFragment();
        for (let i = 1; i <= Number(n); i++) {
          const slide = document.createElement("div");
          slide.className = "lb-slide";
          const img = new Image();
          img.src = src + "/" + String(i).padStart(2, "0") + ".jpg";
          img.alt = titulo + " — foto " + i + " de " + n;
          img.loading = i <= 2 ? "eager" : "lazy";
          img.decoding = "async";
          slide.appendChild(img);
          frag.appendChild(slide);
        }
        track.appendChild(frag);
      }

      // Carrusel de cada evento: scroll-snap nativo + flechas y contador
      document.querySelectorAll(".lightbox").forEach((dlg) => {
        const track = dlg.querySelector(".lb-track");
        const contador = dlg.querySelector(".lb-contador");
        const total = Number(track.dataset.n);
        const ir = (d) =>
          track.scrollBy({ left: d * track.clientWidth, behavior: "smooth" });

        dlg.querySelector(".lb-prev").addEventListener("click", () => ir(-1));
        dlg.querySelector(".lb-next").addEventListener("click", () => ir(1));
        dlg.querySelector(".lb-cerrar").addEventListener("click", () => dlg.close());

        track.addEventListener(
          "scroll",
          () => {
            const i = Math.round(track.scrollLeft / track.clientWidth);
            contador.textContent = i + 1 + " / " + total;
            // Adelanta las dos siguientes por si el navegador hila fino con lazy
            for (let k = i; k < i + 3 && k < total; k++) {
              const img = track.children[k].querySelector("img");
              if (img) img.loading = "eager";
            }
          },
          { passive: true },
        );

        // Clic fuera de la foto = cerrar
        track.addEventListener("click", (ev) => {
          if (ev.target.classList.contains("lb-slide")) dlg.close();
        });

        dlg.addEventListener("keydown", (ev) => {
          if (ev.key === "ArrowRight") { ev.preventDefault(); ir(1); }
          if (ev.key === "ArrowLeft") { ev.preventDefault(); ir(-1); }
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
