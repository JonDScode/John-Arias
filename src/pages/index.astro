---
import Base from "../layouts/Base.astro";
import { site } from "../config";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Un maximo de 3 fotos por trabajo: la galeria muestra variedad de encargos.
// 11 trabajos distintos, 8 categorias. Los alt son los que lee Google.
const works = [
  { src: "boda-confeti.jpg", title: "Boda — La salida", year: "2026", ratio: "3 / 2", size: "wide",
    alt: "Novios saliendo entre confeti rodeados de invitados tras la ceremonia de boda" },
  { src: "comunion-retrato.jpg", title: "Comunión — El retrato", year: "2026", ratio: "3 / 4", size: "narrow",
    alt: "Retrato de niña de primera comunión con vestido de encaje apoyada en un muro de piedra en Vic" },
  { src: "preboda-beso.jpg", title: "Preboda — Sesión de pareja", year: "2026", ratio: "2 / 3", size: "",
    alt: "Pareja besándose en unas escaleras de piedra de un pueblo medieval, fotografía de preboda en blanco y negro" },
  { src: "quince-tarta.jpg", title: "Quinceañera — La tarta", year: "2026", ratio: "2 / 3", size: "",
    alt: "Tarta de quinceañera de tres pisos decorada con mariposas y rosas en tonos lila" },
  { src: "familia-sesion.jpg", title: "Familia — Sesión en exteriores", year: "2026", ratio: "3 / 2", size: "wide",
    alt: "Retrato de familia numerosa posando entre árboles durante una sesión fotográfica al aire libre" },
  { src: "retrato-arbol.jpg", title: "Retratos — Sesión en el bosque", year: "2026", ratio: "3 / 4", size: "narrow",
    alt: "Retrato de joven junto al tronco de un pino durante una sesión fotográfica en el bosque" },
  { src: "boda-ramo.jpg", title: "Boda — El ramo", year: "2026", ratio: "2 / 3", size: "narrow",
    alt: "Ramo de novia con calas blancas y flores azules con medallón conmemorativo" },
  { src: "comunion-rosario.jpg", title: "Comunión — El detalle", year: "2026", ratio: "2 / 3", size: "narrow",
    alt: "Rosario de madera sobre un misal abierto durante una primera comunión" },
  { src: "quince-retrato.jpg", title: "Quinceañera — El retrato", year: "2026", ratio: "1 / 1", size: "narrow",
    alt: "Quinceañera con vestido lila sentada ante la decoración de su fiesta de quince años" },
  { src: "preboda-porche.jpg", title: "Preboda — La masía", year: "2026", ratio: "3 / 5", size: "",
    alt: "Pareja abrazada bajo el porche de madera de una masía en Osona durante su preboda" },
  { src: "boda-emocion.jpg", title: "Boda — La emoción", year: "2026", ratio: "2 / 3", size: "",
    alt: "Novia emocionada sosteniendo una fotografía familiar durante la ceremonia, en blanco y negro" },
  { src: "evento-postres.jpg", title: "Eventos — Mesa dulce", year: "2026", ratio: "3 / 2", size: "wide",
    alt: "Mesa dulce con pasteles y dulces decorados en tonos azules para una fiesta de quince" },
  { src: "food-pollo.jpg", title: "Gastronomía — Carta", year: "2026", ratio: "3 / 5", size: "narrow",
    alt: "Tiras de pollo crujiente con salsas fotografiadas para la carta de un restaurante" },
  { src: "boda2-camino.jpg", title: "Boda — El camino", year: "2026", ratio: "2 / 3", size: "narrow",
    alt: "Novio caminando hacia la ceremonia por un sendero arbolado, en blanco y negro" },
  { src: "preboda-rostros.jpg", title: "Preboda — Complicidad", year: "2026", ratio: "5 / 8", size: "narrow",
    alt: "Retrato cercano de una pareja riendo con las frentes juntas durante su sesión de preboda" },
  { src: "chef-plato.jpg", title: "Gastronomía — El chef", year: "2026", ratio: "2 / 3", size: "narrow",
    alt: "Chef presentando un plato de salmón con aguacate en la cocina de un restaurante" },
  { src: "producto-set.jpg", title: "Producto — El set", year: "2026", ratio: "4 / 7", size: "narrow",
    alt: "Set de fotografía de producto con softbox y cámaras iluminando un plato de restaurante" },
  { src: "evento-montaje.jpg", title: "Eventos — El montaje", year: "2026", ratio: "1 / 1", size: "narrow",
    alt: "Montaje decorativo de fiesta de quinceañera con pared de lentejuelas y globos azules" },
];

const servicios = [
  { nombre: "Bodas", texto: "Cobertura completa del día: preparativos, ceremonia, banquete y fiesta. Fotografía y vídeo, con reportaje entregado en galería online privada." },
  { nombre: "Quinceañeras y comuniones", texto: "Sesión previa y cobertura del evento. Reportajes pensados para que la protagonista disfrute del día sin posar de más." },
  { nombre: "Retratos", texto: "Sesiones individuales, de pareja o familiares en exteriores de Vic y alrededores, o en estudio." },
  { nombre: "Gastronomía y producto", texto: "Fotografía para cartas de restaurante, redes sociales y catálogos. Iluminación de estudio adaptada a cada plato o producto." },
  { nombre: "Vídeo y contenido", texto: "Reels, vídeo de evento y edición para redes. Contenido audiovisual listo para publicar." },
];
---

<Base title="Fotógrafo en Vic, Barcelona — John Arias | Bodas, Quinceañeras y Eventos">
  <section class="hero wrap">
    <div class="hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Fotografía y video — {site.ciudad}, {site.provincia}</p>
        <h1>Recuerdos que duran <em>para siempre</em></h1>
        <p class="lede">
          Bodas, quinceañeras, retratos, producto y eventos. Fotografía y video
          para congelar los momentos que se viven una sola vez.
        </p>
        <p class="scroll-hint">Desliza para ver el trabajo ↓</p>
      </div>
      <img
        class="hero-logo"
        src={`${base}/logo.png`}
        alt=""
        aria-hidden="true"
        width="800"
        height="450"
      />
    </div>
  </section>

  <div class="filmstrip" aria-hidden="true">
    <div class="filmstrip-track">
      {
        [...works, ...works].map((w) => (
          <img src={`${base}/photos/${w.src}`} alt="" loading="lazy" />
        ))
      }
    </div>
  </div>

  <section class="section" id="video">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>Video</h2>
        <p class="eyebrow">Contenido audiovisual</p>
      </div>
      <div class="video-grid">
        <figure class="reveal">
          <video
            src={`${base}/videos/reel-gastronomia.mp4`}
            data-scroll-play
            muted
            loop
            controls
            preload="metadata"
            playsinline
          ></video>
          <figcaption>Gastronomía — 80&apos;s Spirit, Vic</figcaption>
        </figure>
        <figure class="reveal" style="--reveal-delay: 120ms">
          <video
            src={`${base}/videos/reel-sesion.mp4`}
            controls
            preload="metadata"
            playsinline
          ></video>
          <figcaption>Detrás de cámara — Sesión de retrato</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section" id="trabajo">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>Trabajo seleccionado</h2>
        <p class="eyebrow">2024 — 2026 · Haz clic en una foto 📸</p>
      </div>
      <div class="work-grid">
        {
          works.map((w) => (
            <a class={`work-item reveal ${w.size}`} href="#trabajo">
              <figure>
                <img
                  src={`${base}/photos/${w.src}`}
                  alt={w.alt}
                  loading="lazy"
                  style={`--ratio: ${w.ratio}`}
                />
                <figcaption>
                  <span>{w.title}</span>
                  <span>{w.year}</span>
                </figcaption>
              </figure>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="servicios">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>Servicios</h2>
        <p class="eyebrow">Vic · Osona · Barcelona</p>
      </div>
      <div class="servicios-grid">
        {
          servicios.map((s, i) => (
            <article class="reveal" style={`--reveal-delay: ${(i % 3) * 90}ms`}>
              <h3>{s.nombre}</h3>
              <p>{s.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="sobre-mi">
    <div class="wrap about reveal">
      <p class="eyebrow">Sobre mí</p>
      <div>
        <p class="bio">
          Soy John Arias, fotógrafo y creador de contenido audiovisual en {site.ciudad}. Acompaño bodas, quinces y celebraciones <em>creando recuerdos</em> que duran para siempre.
        </p>
        <div class="meta">
          <span>Producto · Retratos · Bodas · Eventos</span>
          <span>{site.ciudad}, {site.provincia} — disponible para desplazarse</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section contact" id="contacto">
    <div class="wrap reveal">
      <p class="eyebrow">Contacto</p>
      <h2>Hablemos de tu próxima celebración</h2>

      <p class="contact-nap">
        <a href={`tel:${site.telefonoLink}`}>{site.telefono}</a>
        <span aria-hidden="true">·</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span aria-hidden="true">·</span>
        <span>{site.ciudad}, {site.provincia}</span>
      </p>

      <form
        class="lead-form"
        action={`https://formsubmit.co/${site.email}`}
        method="POST"
      >
        <input type="hidden" name="_subject" value="Nueva solicitud desde la web" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value={`${site.url}${site.base}/gracias/`} />
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

        <div class="form-row">
          <label>
            Nombre
            <input required type="text" name="nombre" placeholder="Tu nombre" />
          </label>
          <label>
            Email
            <input required type="email" name="email" placeholder="tu@correo.com" />
          </label>
        </div>
        <div class="form-row">
          <label>
            Servicio
            <select name="servicio">
              <option>Bodas</option>
              <option>Quinceañeras</option>
              <option>Comuniones</option>
              <option>Retratos</option>
              <option>Gastronomía / Producto</option>
              <option>Vídeo</option>
              <option>Otro</option>
            </select>
          </label>
          <label>
            Fecha del evento (opcional)
            <input type="date" name="fecha" />
          </label>
        </div>
        <label>
          Cuéntame tu idea
          <textarea name="mensaje" rows="4" placeholder="Qué celebras, dónde, qué tienes en mente..."></textarea>
        </label>
        <button type="submit">Enviar solicitud</button>
        <p class="form-note">
          También puedes escribir directo por
          <a href={site.instagram} target="_blank" rel="noopener" style="color: var(--accent);">Instagram</a>
          o ver las
          <a href={site.galerias} target="_blank" rel="noopener" style="color: var(--accent);">galerías de clientes</a>.
        </p>
      </form>
    </div>
  </section>
</Base>
