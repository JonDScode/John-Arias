---
import Base from "../layouts/Base.astro";
import { site } from "../config";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// alt descriptivos: son los que lee Google y los lectores de pantalla
const works = [
  { src: "boda-ramo.jpg", title: "Bodas — El ramo", year: "2026", ratio: "2 / 3", size: "",
    alt: "Ramo de novia con calas blancas y flores azules, con medallón conmemorativo, en una boda en Vic" },
  { src: "boda-novia.jpg", title: "Bodas — La novia", year: "2026", ratio: "2 / 3", size: "",
    alt: "Retrato de novia con velo y capa de tul en el jardín de una finca de bodas en Barcelona" },
  { src: "boda-confeti.jpg", title: "Bodas — La salida", year: "2026", ratio: "3 / 2", size: "wide",
    alt: "Novios saliendo entre confeti y arroz rodeados de invitados tras la ceremonia" },
  { src: "evento-montaje.jpg", title: "Eventos — El montaje", year: "2026", ratio: "1 / 1", size: "narrow",
    alt: "Montaje decorativo de fiesta de quinceañera con pared de lentejuelas y globos azules" },
  { src: "boda-emocion.jpg", title: "Bodas — La emoción", year: "2026", ratio: "2 / 3", size: "narrow",
    alt: "Novia emocionada sosteniendo una fotografía familiar durante la ceremonia, en blanco y negro" },
  { src: "boda-anillos.jpg", title: "Bodas — Los anillos", year: "2026", ratio: "9 / 10", size: "narrow",
    alt: "Intercambio de anillos entre los novios bajo el arco floral de la ceremonia" },
  { src: "boda-novio.jpg", title: "Bodas — El novio", year: "2026", ratio: "2 / 3", size: "narrow",
    alt: "Retrato en blanco y negro del novio esperando el inicio de la ceremonia" },
  { src: "deco-centro.jpg", title: "Eventos — Decoración", year: "2026", ratio: "5 / 8", size: "",
    alt: "Centro de mesa con rosas azules y hortensias en una celebración de quince años" },
  { src: "boda-arco.jpg", title: "Bodas — El detalle", year: "2026", ratio: "2 / 3", size: "",
    alt: "Arco floral decorado con cintas blancas en una ceremonia de boda al aire libre" },
  { src: "boda-pareja.jpg", title: "Bodas — Los novios", year: "2026", ratio: "3 / 2", size: "wide",
    alt: "Los novios sentados juntos durante la ceremonia civil en el jardín" },
  { src: "evento-catering.jpg", title: "Gastronomía — Catering", year: "2026", ratio: "2 / 3", size: "narrow",
    alt: "Bandeja de miniburgers y aperitivos de jamón en el catering de una celebración" },
  { src: "food-burger.jpg", title: "Gastronomía — Carta", year: "2026", ratio: "3 / 5", size: "",
    alt: "Hamburguesa gourmet con guacamole y nachos fotografiada para la carta de un restaurante" },
  { src: "chef-plato.jpg", title: "Gastronomía — El chef", year: "2026", ratio: "2 / 3", size: "",
    alt: "Chef presentando un plato de salmón con aguacate en la cocina de un restaurante" },
  { src: "evento-postres.jpg", title: "Eventos — Mesa dulce", year: "2026", ratio: "3 / 2", size: "wide",
    alt: "Mesa dulce con pasteles y dulces decorados en tonos azules para una fiesta de quince" },
  { src: "producto-set.jpg", title: "Producto — El set", year: "2026", ratio: "4 / 7", size: "narrow",
    alt: "Set de fotografía de producto con softbox y cámaras iluminando un plato de restaurante" },
];

const servicios = [
  { nombre: "Bodas", texto: "Cobertura completa del día: preparativos, ceremonia, banquete y fiesta. Fotografía y vídeo, con reportaje entregado en galería online privada." },
  { nombre: "Quinceañeras y comuniones", texto: "Sesión previa y cobertura del evento. Reportajes pensados para que la protagonista disfrute del día sin posar de más." },
  { nombre: "Retratos", texto: "Sesiones individuales, de pareja o familiares en exteriores de Vic y alrededores, o en estudio." },
  { nombre: "Gastronomía y producto", texto: "Fotografía para cartas de restaurante, redes sociales y catálogos. Iluminación de estudio adaptada a cada plato o producto." },
  { nombre: "Vídeo y contenido", texto: "Reels, vídeo de evento y edición para redes. Contenido audiovisual listo para publicar." },
];
---

<Base title="Fotógrafo en Vic, Barcelona — John Arias | Bodas, Quinceañeras y Eventos">
  <section class="hero wrap">
    <div class="hero-inner">
      <p class="eyebrow">Fotografía y video — {site.ciudad}, {site.provincia}</p>
      <h1>Recuerdos que duran <em>para siempre</em></h1>
      <p class="lede">
        Bodas, quinceañeras, retratos, producto y eventos. Fotografía y video
        para congelar los momentos que se viven una sola vez.
      </p>
      <p class="scroll-hint">Desliza para ver el trabajo ↓</p>
    </div>
  </section>

  <div class="filmstrip" aria-hidden="true">
    <div class="filmstrip-track">
      {
        [...works, ...works].map((w) => (
          <img src={`${base}/photos/${w.src}`} alt="" loading="lazy" />
        ))
      }
    </div>
  </div>

  <section class="section" id="video">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>Video</h2>
        <p class="eyebrow">Contenido audiovisual</p>
      </div>
      <div class="video-grid">
        <figure class="reveal">
          <video src={`${base}/videos/reel-01.mp4`} controls preload="metadata" playsinline></video>
          <figcaption>Comunión — Vic</figcaption>
        </figure>
        <figure class="reveal" style="--reveal-delay: 120ms">
          <video
            src={`${base}/videos/reel-02.mp4`}
            data-scroll-play
            muted
            loop
            controls
            preload="metadata"
            playsinline
          ></video>
          <figcaption>Fiesta de XV</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section" id="trabajo">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>Trabajo seleccionado</h2>
        <p class="eyebrow">2024 — 2026 · Haz clic en una foto 📸</p>
      </div>
      <div class="work-grid">
        {
          works.map((w) => (
            <a class={`work-item reveal ${w.size}`} href="#trabajo">
              <figure>
                <img
                  src={`${base}/photos/${w.src}`}
                  alt={w.alt}
                  loading="lazy"
                  style={`--ratio: ${w.ratio}`}
                />
                <figcaption>
                  <span>{w.title}</span>
                  <span>{w.year}</span>
                </figcaption>
              </figure>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="servicios">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>Servicios</h2>
        <p class="eyebrow">Vic · Osona · Barcelona</p>
      </div>
      <div class="servicios-grid">
        {
          servicios.map((s, i) => (
            <article class="reveal" style={`--reveal-delay: ${(i % 3) * 90}ms`}>
              <h3>{s.nombre}</h3>
              <p>{s.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="sobre-mi">
    <div class="wrap about reveal">
      <p class="eyebrow">Sobre mí</p>
      <div>
        <p class="bio">
          Soy John Arias, fotógrafo y creador de contenido audiovisual en {site.ciudad}. Acompaño bodas, quinces y celebraciones <em>creando recuerdos</em> que duran para siempre.
        </p>
        <div class="meta">
          <span>Producto · Retratos · Bodas · Eventos</span>
          <span>{site.ciudad}, {site.provincia} — disponible para desplazarse</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section contact" id="contacto">
    <div class="wrap reveal">
      <p class="eyebrow">Contacto</p>
      <h2>Hablemos de tu próxima celebración</h2>

      <p class="contact-nap">
        <a href={`tel:${site.telefonoLink}`}>{site.telefono}</a>
        <span aria-hidden="true">·</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span aria-hidden="true">·</span>
        <span>{site.ciudad}, {site.provincia}</span>
      </p>

      <form
        class="lead-form"
        action={`https://formsubmit.co/${site.email}`}
        method="POST"
      >
        <input type="hidden" name="_subject" value="Nueva solicitud desde la web" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value={`${site.url}${site.base}/gracias/`} />
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

        <div class="form-row">
          <label>
            Nombre
            <input required type="text" name="nombre" placeholder="Tu nombre" />
          </label>
          <label>
            Email
            <input required type="email" name="email" placeholder="tu@correo.com" />
          </label>
        </div>
        <div class="form-row">
          <label>
            Servicio
            <select name="servicio">
              <option>Bodas</option>
              <option>Quinceañeras</option>
              <option>Comuniones</option>
              <option>Retratos</option>
              <option>Gastronomía / Producto</option>
              <option>Vídeo</option>
              <option>Otro</option>
            </select>
          </label>
          <label>
            Fecha del evento (opcional)
            <input type="date" name="fecha" />
          </label>
        </div>
        <label>
          Cuéntame tu idea
          <textarea name="mensaje" rows="4" placeholder="Qué celebras, dónde, qué tienes en mente..."></textarea>
        </label>
        <button type="submit">Enviar solicitud</button>
        <p class="form-note">
          También puedes escribir directo por
          <a href={site.instagram} target="_blank" rel="noopener" style="color: var(--accent);">Instagram</a>
          o ver las
          <a href={site.galerias} target="_blank" rel="noopener" style="color: var(--accent);">galerías de clientes</a>.
        </p>
      </form>
    </div>
  </section>
</Base>
